#!/bin/sh
# Runs inside the {{ kiosk_compositor }} compositor as {{ kiosk_user }}.
# 127.0.0.1 is the security boundary: the screen is only reachable through
# the Svenager agent's authenticated reverse tunnel, never over the network.
{% if kiosk_compositor == 'cage' %}
# --disable-input: cage does not implement the virtual pointer/keyboard
# protocols, so the kiosk remote view is watch-only under cage.
{% else %}
# sway implements the virtual pointer/keyboard protocols, so the remote
# view can control the kiosk.
{% endif %}
# The PAM login session leaks an ambient cap_wake_alarm into the kiosk
# process; bwrap (WebKit's sandbox helper) refuses to run non-setuid while
# holding an unexpected capability, so the browser renders nothing. Drop
# inherited/ambient caps before cog — the WebKit sandbox itself stays on.
drop_caps="setpriv --inh-caps -all --ambient-caps -all"

# D-Bus-activated portals need the display; without it portal-gtk fails
# and WebKit's sandbox stalls page loads on portal timeouts (~50 s).
dbus-update-activation-environment --systemd WAYLAND_DISPLAY

# Supervised in a loop — at session start wayvnc can race the compositor's
# output setup.
(
  while true; do
    wayvnc {% if kiosk_compositor == 'cage' %}--disable-input {% endif %}127.0.0.1 {{ kiosk_vnc_port }}
    sleep 2
  done
) &
{% if kiosk_compositor == 'sway' and kiosk_second_url %}
# sway assigns each browser to its screen by app_id; start the second
# screen first and finish on workspace 1 so the main page gets keyboard
# focus. kiosk-browser.sh ends the session when either browser exits.
swaymsg "workspace 2; exec /usr/local/bin/kiosk-browser.sh 2"
swaymsg "workspace 1; exec /usr/local/bin/kiosk-browser.sh 1"
wait
{% elif kiosk_compositor == 'sway' %}
$drop_caps cog --platform=wl "{{ kiosk_url }}"
# cog ended (crash or exit) — end the compositor too, so systemd restarts
# the whole session cleanly (same semantics as cage's session child).
swaymsg exit
{% else %}
exec $drop_caps cog --platform=wl "{{ kiosk_url }}"
{% endif %}
